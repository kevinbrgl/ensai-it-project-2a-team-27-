# URL of the FastAPI backend (the server started with `uv run src/main.py`).
# The Vite dev server forwards every /api request to this address.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Optional: full URL of the API if you serve the built app yourself and the
# backend accepts cross-origin requests. Leave empty to use the Vite proxy.
VITE_API_URL=

# Optional: port of the dev server (default 5173).
VITE_PORT=5173

# Optional: public base path when the app is served under a sub-path,
# e.g. /absproxy/5173/ on Onyxia/VSCode. Must start and end with "/".
VITE_BASE_PATH=/
